# Pure native Intel SYCL / oneAPI backend configuration (INGINE_BACKEND=SYCL).
# Incorporates compiler, Level Zero direct-allocation, and oneDNN/oneMKL discovery patterns
# studied from ggml-sycl (MIT). Zero Python runtime shims.

include(CheckCXXCompilerFlag)
check_cxx_compiler_flag("-fsycl" INGINE_COMPILER_SUPPORTS_SYCL)

find_package(IntelSYCL QUIET)
if(TARGET IntelSYCL::SYCL_CXX)
  set(INGINE_SYCL_PACKAGE_FOUND ON)
  message(STATUS "ingine SYCL: using IntelSYCL::SYCL_CXX (icpx / oneAPI)")
elseif(INGINE_COMPILER_SUPPORTS_SYCL)
  set(INGINE_SYCL_PACKAGE_FOUND OFF)
  message(STATUS "ingine SYCL: using -fsycl flag fallback (clang++/DPCPP)")
else()
  message(FATAL_ERROR
    "INGINE_BACKEND=SYCL requires oneAPI icpx (setvars.sh) or a -fsycl capable C++20 compiler")
endif()

option(INGINE_SYCL_LEVEL_ZERO "Enable Level Zero loader discovery for direct Intel GPU USM allocations" ON)
set(INGINE_HAVE_LEVEL_ZERO OFF)
if(INGINE_SYCL_LEVEL_ZERO)
  find_path(INGINE_ZE_INCLUDE_DIR level_zero/ze_api.h
    HINTS "$ENV{ONEAPI_ROOT}/include" "$ENV{LEVEL_ZERO_V1_SDK_PATH}/include")
  find_library(INGINE_ZE_LOADER_LIB ze_loader
    HINTS "$ENV{ONEAPI_ROOT}/lib" "$ENV{LEVEL_ZERO_V1_SDK_PATH}/lib" ENV LD_LIBRARY_PATH)
  if(INGINE_ZE_INCLUDE_DIR AND INGINE_ZE_LOADER_LIB)
    set(INGINE_HAVE_LEVEL_ZERO ON)
    message(STATUS "ingine SYCL: Level Zero direct loader enabled (${INGINE_ZE_LOADER_LIB})")
  endif()
endif()

option(INGINE_SYCL_MKL "Enable oneMKL SYCL BLAS discovery for dense GEMMs" ON)
set(INGINE_HAVE_MKL_SYCL OFF)
if(INGINE_SYCL_MKL)
  find_package(MKL CONFIG QUIET)
  if(TARGET MKL::MKL_DPCPP)
    set(INGINE_HAVE_MKL_SYCL ON)
    message(STATUS "ingine SYCL: found MKL::MKL_DPCPP")
  endif()
endif()

function(ingine_sycl_target target)
  if(INGINE_SYCL_PACKAGE_FOUND)
    target_link_libraries(${target} PUBLIC IntelSYCL::SYCL_CXX)
  else()
    target_compile_options(${target} PRIVATE -fsycl)
    target_link_options(${target} PUBLIC -fsycl)
  endif()
  target_compile_options(${target} PRIVATE -Wno-narrowing)
  if(INGINE_HAVE_LEVEL_ZERO)
    target_include_directories(${target} PRIVATE "${INGINE_ZE_INCLUDE_DIR}")
    target_link_libraries(${target} PUBLIC "${INGINE_ZE_LOADER_LIB}")
    target_compile_definitions(${target} PRIVATE INGINE_SYCL_LEVEL_ZERO=1)
  else()
    target_compile_definitions(${target} PRIVATE INGINE_SYCL_LEVEL_ZERO=0)
  endif()
  if(INGINE_HAVE_MKL_SYCL)
    target_link_libraries(${target} PUBLIC MKL::MKL_DPCPP)
    target_compile_definitions(${target} PRIVATE INGINE_SYCL_HAVE_MKL=1)
  else()
    target_compile_definitions(${target} PRIVATE INGINE_SYCL_HAVE_MKL=0)
  endif()
endfunction()
