{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release binaries",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "120a",
        "INGINE_BUILD_APPS": "ON",
        "INGINE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Release binaries and tests",
      "inherits": "release",
      "cacheVariables": {
        "INGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "install",
      "displayName": "ingine-serve for scripts/install.sh: private CUDA toolkit in ../.cuda-toolkit, RPATH into it",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-install",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "86;89;120a",
        "CMAKE_CUDA_COMPILER": "${sourceDir}/../.cuda-toolkit/nvidia/cu13/bin/nvcc",
        "CUDAToolkit_ROOT": "${sourceDir}/../.cuda-toolkit/nvidia/cu13",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "CMAKE_INSTALL_RPATH": "$ORIGIN/../../../../.cuda-toolkit/nvidia/cu13/lib"
      }
    },
    {
      "name": "multiarch-dev",
      "displayName": "Multi-arch (sm_86/89/120a) binaries and FP64-oracle tests with private CUDA 13.4",
      "inherits": "install",
      "binaryDir": "${sourceDir}/build-multiarch",
      "cacheVariables": {
        "INGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sm70",
      "displayName": "Volta sm_70 (V100) release binaries with CUDA 12.9 and FP16 activations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sm70",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "70",
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda-12.9/bin/nvcc",
        "CUDAToolkit_ROOT": "/usr/local/cuda-12.9",
        "INGINE_ACT_FP16": "ON",
        "INGINE_BUILD_APPS": "ON",
        "INGINE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "sm70-dev",
      "displayName": "Volta sm_70 (V100) binaries and FP64-oracle tests with CUDA 12.9",
      "inherits": "sm70",
      "cacheVariables": {
        "INGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sm70-simt-dev",
      "displayName": "Volta sm_70 with INGINE_FORCE_SIMT_MMA=ON to verify Pascal sm_60/61 SIMT MMA on V100",
      "inherits": "sm70-dev",
      "binaryDir": "${sourceDir}/build-sm70-simt",
      "cacheVariables": {
        "INGINE_FORCE_SIMT_MMA": "ON"
      }
    },
    {
      "name": "legacy-fp16",
      "displayName": "Legacy multi-arch FP16 (Pascal sm_60/61, Volta sm_70, Turing sm_75) with CUDA 12.9",
      "inherits": "sm70",
      "binaryDir": "${sourceDir}/build-legacy-fp16",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "60;61;70;75",
        "INGINE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "install", "configurePreset": "install" },
    { "name": "multiarch-dev", "configurePreset": "multiarch-dev" },
    { "name": "sm70", "configurePreset": "sm70" },
    { "name": "sm70-dev", "configurePreset": "sm70-dev" },
    { "name": "sm70-simt-dev", "configurePreset": "sm70-simt-dev" },
    { "name": "legacy-fp16", "configurePreset": "legacy-fp16" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "multiarch-dev",
      "configurePreset": "multiarch-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sm70-dev",
      "configurePreset": "sm70-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sm70-simt-dev",
      "configurePreset": "sm70-simt-dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
